{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "jit.content.request.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "catalogVersion": {
      "type": "string",
      "const": "jit-device.v2"
    },
    "locale": {
      "type": "string",
      "minLength": 2
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "targets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "elementId": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "enum": [
              "Heading",
              "Text",
              "Label",
              "Metric",
              "Media",
              "Badge",
              "ListItem",
              "Bars",
              "Rule",
              "Button",
              "TextField",
              "Toggle",
              "Progress",
              "Alert",
              "Slider"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "number",
                    "boolean",
                    "number[]"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "constraints": {
                  "type": "object",
                  "properties": {
                    "minLength": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "maxLength": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "minimum": {
                      "type": "number"
                    },
                    "maximum": {
                      "type": "number"
                    },
                    "minItems": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "maxItems": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "allowedValues": {
                      "type": "array",
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      }
                    },
                    "format": {
                      "type": "string",
                      "const": "plain-text"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "type",
                "required"
              ],
              "additionalProperties": false
            }
          },
          "fixed": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "sourceFacts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        },
        "required": [
          "elementId",
          "component",
          "purpose",
          "fields",
          "fixed"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract",
    "requestId",
    "catalogVersion",
    "locale",
    "intent",
    "context",
    "targets"
  ],
  "additionalProperties": false
}
