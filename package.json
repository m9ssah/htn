{
  "name": "jit-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "verify:jev-preview": "sh scripts/verify-json-render-preview.sh",
    "jev:smoke": "npm run build -w @jit/server && node --env-file-if-exists=.env apps/server/dist/jev-smoke.js",
    "test:watch": "vitest",
    "harness": "npm run harness -w @jit/renderer",
    "node": "npm run node -w @jit/server --",
    "serve": "npm run serve -w @jit/server",
    "live-jev": "npm run live-jev -w @jit/server --",
    "record-jev-fixtures": "npm run record-jev-fixtures -w @jit/server --",
    "clean": "rm -rf packages/*/dist apps/*/dist && find . -name '*.tsbuildinfo' -not -path '*/node_modules/*' -delete",
    "dev": "npm run dev -w @jit/device",
    "dataset:generate": "npm run dataset:generate -w @jit/server",
    "dataset:validate": "npm run dataset:validate -w @jit/server",
    "dataset:schemas": "npm run dataset:schemas -w @jit/server"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "^20.0.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
