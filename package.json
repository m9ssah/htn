{
  "name": "jit-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness": "npm run harness -w @jit/renderer",
    "node": "npm run node -w @jit/server --",
    "live-jev": "npm run live-jev -w @jit/server --",
    "live-generate": "npm run live-generate -w @jit/server --",
    "record-jev-fixtures": "npm run record-jev-fixtures -w @jit/server --",
    "clean": "rm -rf packages/*/dist apps/*/dist && find . -name '*.tsbuildinfo' -not -path '*/node_modules/*' -delete",
    "dev": "npm run dev -w @jit/device"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "happy-dom": "^20.0.10",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
